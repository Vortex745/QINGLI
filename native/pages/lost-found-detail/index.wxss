.container {
    min-height: 100vh;
    background-color: #F8F9FA;
    display: flex;
    flex-direction: column;
}

.main-scroll {
    flex: 1;
    height: 100vh;
    box-sizing: border-box;
}

/* Nav */
.nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    pointer-events: none;
}

.nav-content {
    height: 44px;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    pointer-events: auto;
}

.circle-btn {
    width: 68rpx;
    height: 68rpx;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.nav-icon {
    width: 40rpx;
    height: 40rpx;
}

/* Header */
.seller-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 30rpx;
    background-color: #fff;
}

.seller-left {
    display: flex;
    align-items: center;
}

.seller-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    border: 2rpx solid #EAF2EB;
}

.seller-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #1A1A1A;
}

.seller-meta {
    font-size: 22rpx;
    color: #8C9991;
    margin-top: 6rpx;
}

.follow-btn {
    padding: 12rpx 32rpx;
    border-radius: 32rpx;
    background-color: #214D39;
    color: #fff;
    font-size: 24rpx;
}

/* Images */
.image-section {
    width: 100%;
    height: 600rpx;
    background-color: #f0f0f0;
}

.image-swiper, .product-img {
    width: 100%;
    height: 100%;
}

/* Info */
.section-title-box {
    padding: 40rpx 30rpx 32rpx;
    background-color: #fff;
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.lf-tag {
    font-size: 24rpx;
    padding: 6rpx 20rpx;
    border-radius: 12rpx;
    font-weight: 800;
}

.tag-lost { background-color: #FFF2F0; color: #FF4D4F; }
.tag-found { background-color: #E6F7FF; color: #1890FF; }

.item-name {
    font-size: 42rpx;
    font-weight: 800;
    color: #1A1A1A;
    line-height: 1.4;
}

.section-params {
    margin: 30rpx;
    background-color: #fff;
    border-radius: 24rpx;
    padding: 40rpx;
    box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
    border: 1rpx solid #F0F2F0;
}

.detail-row {
    display: flex;
    align-items: center;
    margin-bottom: 32rpx;
}

.detail-row:last-child { margin-bottom: 0; }

.detail-label {
    color: #8C9991;
    font-size: 28rpx;
    width: 140rpx;
    font-weight: 500;
}

.detail-value {
    color: #1A1A1A;
    font-size: 30rpx;
    font-weight: 600;
}

.section-content {
    background-color: #fff;
    padding: 50rpx 30rpx;
    margin-top: 20rpx;
    border-radius: 32rpx 32rpx 0 0;
}

.section-header { margin-bottom: 32rpx; }

.section-title {
    font-size: 34rpx;
    font-weight: 800;
    color: #1A1A1A;
}

.section-title::before {
    content: '';
    width: 8rpx;
    height: 34rpx;
    background: #214D39;
    border-radius: 4rpx;
    margin-right: 20rpx;
    display: inline-block;
    vertical-align: middle;
}

.goods-desc {
    font-size: 32rpx;
    color: #3D4440;
    line-height: 1.8;
    white-space: pre-wrap;
    padding: 0 10rpx;
}

/* Stats */
.post-stats {
    padding: 20rpx 30rpx;
    background-color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 24rpx;
    color: #999;
    border-bottom: 1rpx solid #F0F2F0;
}

.stats-right { display: flex; gap: 30rpx; }

.stats-row {
    background-color: #fff;
    padding: 20rpx 30rpx;
    border-bottom: 1rpx solid #f8f8f8;
}

.stats-left {
    display: flex;
    align-items: center;
    font-size: 24rpx;
    color: #999;
}

.divider {
    margin: 0 10rpx;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.stat-icon {
    width: 36rpx;
    height: 36rpx;
}

/* Bottom */
.bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: #fff;
    padding: 24rpx 40rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    box-shadow: 0 -10rpx 30rpx rgba(0,0,0,0.05);
}

.bar-left { 
    display: flex;
    align-items: center;
    padding: 0 20rpx;
}

.bar-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100rpx;
}

.bar-icon {
    width: 48rpx;
    height: 48rpx;
    margin-bottom: 4rpx;
}

.bar-btn:last-child .bar-icon {
    width: 48rpx;
    height: 48rpx;
    margin-top: 0;
    margin-bottom: 4rpx;
}

.bar-btn text {
    font-size: 22rpx;
    color: #666;
    line-height: normal;
}

.bar-right { flex: 1; }

.buy-now-btn {
    width: 100%;
    height: 96rpx;
    background: linear-gradient(135deg, #2D5D46 0%, #214D39 100%);
    border-radius: 48rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 32rpx;
    font-weight: 700;
}

.spacer-large {
    height: 200rpx;
}

/* Nav Actions */
.nav-content {
    justify-content: space-between;
}

.nav-actions { display: flex; }

.share-dot {
    font-weight: bold;
    color: #214D39;
    letter-spacing: 2rpx;
}

/* Report Modal Styles */
.report-modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9100;
}

.report-modal {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 80vh;
    background: #fff;
    border-radius: 32rpx 32rpx 0 0;
    z-index: 9101;
    transform: translateY(100%);
    transition: transform 0.3s ease;
}

.report-modal.show {
    transform: translateY(0);
}

.report-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.report-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #1a1a1a;
}

.report-close {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48rpx;
    color: #999;
}

.report-body {
    padding: 30rpx;
    max-height: 50vh;
    overflow-y: auto;
}

.report-section {
    margin-bottom: 40rpx;
}

.report-label {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 20rpx;
    display: block;
}

.report-types {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.report-type-item {
    padding: 16rpx 28rpx;
    border-radius: 32rpx;
    border: 2rpx solid #e0e0e0;
    font-size: 26rpx;
    color: #666;
    background: #fff;
}

.report-type-item.active {
    border-color: #214D39;
    background: #EAF2EB;
    color: #214D39;
    font-weight: 600;
}

.report-textarea {
    width: 100%;
    height: 200rpx;
    padding: 24rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 16rpx;
    font-size: 28rpx;
    box-sizing: border-box;
    background: #fafafa;
}

.report-count {
    display: block;
    text-align: right;
    font-size: 24rpx;
    color: #999;
    margin-top: 12rpx;
}

.report-footer {
    display: flex;
    padding: 24rpx 30rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    gap: 20rpx;
    border-top: 1rpx solid #f0f0f0;
}

.report-btn {
    flex: 1;
    height: 88rpx;
    border-radius: 44rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30rpx;
    font-weight: 600;
}

.report-btn.cancel {
    background: #f5f5f5;
    color: #666;
}

.report-btn.submit {
    background: #214D39;
    color: #fff;
}
