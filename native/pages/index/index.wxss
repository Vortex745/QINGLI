/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: 120rpx;
}

/* ======= Header Search (Restored Original) ======= */
.header-search {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.location-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 180rpx;
}

.location-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow-down {
  width: 0; 
  height: 0; 
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #1A1A1A;
  margin-top: 4rpx;
}

.search-bar {
  flex: 1;
  background-color: #f2f3f5;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  transition: all 0.2s ease;
}

.search-bar:active {
  background-color: #ebecf0;
  transform: scale(0.98);
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-hint {
  font-size: 28rpx;
  color: #8E8E93;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: transform 0.2s;
}

.icon-btn:active {
  transform: scale(0.9);
}

.notification-icon {
  width: 48rpx;
  height: 48rpx;
}

.unread-dot {
  position: absolute;
  top: 12rpx;
  right: 8rpx;
  min-width: 16rpx;
  height: 16rpx;
  background-color: #FF3B30;
  border-radius: 50%;
  border: 4rpx solid #fff;
  z-index: 100;
}

@keyframes pulseDot {
  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0.7); }
  70% { transform: scale(1.1); box-shadow: 0 0 0 10rpx rgba(255, 59, 48, 0); }
  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 59, 48, 0); }
}

/* ======= Quick Actions ======= */
.quick-actions {
  display: flex;
  justify-content: space-between;
  padding: 30rpx 50rpx;
  background: #fff;
  margin-bottom: 0rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

.action-item:active {
  transform: scale(0.9);
  opacity: 0.8;
}

.icon-box {
  width: 100rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
  border: 1rpx solid #f8f9fa;
  animation: iconEntrance 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) backwards;
}

/* Dynamic entrance delays */
.action-item:nth-child(1) .icon-box { animation-delay: 0.1s; }
.action-item:nth-child(2) .icon-box { animation-delay: 0.2s; }
.action-item:nth-child(3) .icon-box { animation-delay: 0.3s; }

@keyframes iconEntrance {
  from { transform: scale(0.5) translateY(20rpx); opacity: 0; }
  to { transform: scale(1) translateY(0); opacity: 1; }
}

.action-icon {
  width: 52rpx;
  height: 52rpx;
  transition: transform 0.3s;
}

.action-item:active .action-icon {
  transform: rotate(5deg);
}

.action-text {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
}

/* ======= Albums Section ======= */
.albums-section {
  padding: 0 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  margin-top: 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1A1A1A;
}

.header-right {
  display: flex;
  align-items: center;
}

.see-all {
  font-size: 24rpx;
  color: #999;
  transition: all 0.3s;
}

.active-tab {
  color: #1A1A1A;
  font-weight: 700;
}

.divider {
  margin: 0 12rpx;
  color: #ddd;
  font-size: 20rpx;
}

/* ======= Masonry Grid (2 Columns) ======= */
.masonry-grid {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.masonry-column {
  width: 48.5%; /* Ensures 2 items per row */
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ======= Goods Card (Simplified) ======= */
.goods-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  break-inside: avoid;
  padding-bottom: 20rpx;
}

/* Image Container */
.card-image {
  width: 100%;
  position: relative;
  background: #f8f8f8;
  border-radius: 16rpx 16rpx 0 0;
}

.goods-img {
  width: 100%;
  display: block;
}

.play-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  width: 18rpx;
  height: 18rpx;
}

/* Card Content (Tightened) */
.card-content {
  padding: 16rpx 16rpx 0;
}

.title-wrap {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Price Line */
.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between; /* Space out price and avatar */
  margin-top: 10rpx;
}

.price-box {
  display: flex;
  align-items: baseline;
}

.currency { 
  font-size: 22rpx; 
  color: #FF5555; 
  font-weight: 800; 
  margin-right: 2rpx;
}

.price-int { 
  font-size: 34rpx; 
  color: #FF5555; 
  font-weight: 800; 
  font-family: -apple-system, sans-serif;
}

/* Seller Info for Simplified Layout */
.seller-row-compact {
  display: flex;
  align-items: center;
}

.seller-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #eee;
  /* Removed margin-right to fit tight layout if needed, but keeping for separation */
  margin-right: 8rpx; 
}

.seller-name {
  font-size: 20rpx;
  color: #999;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ======= Pull-to-Refresh Layout ======= */
.page-scroll {
    height: 100vh;
}

.refresh-container {
    width: 100%;
    height: 80rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.refresh-icon {
    width: 48rpx;
    height: 48rpx;
}

.rotating {
    animation: rotate 1s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* ======= States ======= */
.loading-state, .no-more {
  text-align: center;
  padding: 40rpx 0;
  color: #ccc;
  font-size: 24rpx;
  width: 100%;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  color: #999;
  font-size: 26rpx;
}

/* ======= Status Blocking UI ======= */
.page-container {
    position: relative;
    width: 100%;
    height: 100vh;
}

.status-block {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #fff;
    z-index: 1000;
}

.status-icon {
    width: 160rpx;
    height: 160rpx;
    margin-bottom: 40rpx;
}

.status-text {
    font-size: 30rpx;
    color: #666;
    margin-bottom: 60rpx;
}

.status-btn {
    width: 240rpx;
    height: 80rpx;
    line-height: 80rpx;
    background: #000;
    color: #fff;
    font-size: 28rpx;
    border-radius: 40rpx;
    text-align: center;
    padding: 0;
}

/* ======= Back To Top ======= */
.back-top {
  position: fixed;
  right: 40rpx;
  bottom: 160rpx; /* Above bottom tab bar/safe area */
  width: 90rpx;
  height: 90rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
  opacity: 0;
  transform: scale(0);
}

.back-top.show {
  opacity: 1;
  transform: scale(1);
}

.back-top-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.9;
}
