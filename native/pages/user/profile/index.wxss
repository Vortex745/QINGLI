/** pages/user/profile/index.wxss **/
.page {
  min-height: 100vh;
  background-color: #f6f7f9; /* 浅灰背景使卡片更立体 */
}

/* Custom Nav Bar */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1001;
  display: flex;
  align-items: center;
}

.nav-top-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 220rpx;
  background: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0) 100%);
  pointer-events: none;
  z-index: 1000;
}

.nav-back {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  z-index: 1002;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid #fff;
  border-left: 4rpx solid #fff;
  transform: rotate(-45deg);
}

.nav-title {
  font-weight: 600;
  font-size: 32rpx;
  flex: 1;
  text-align: center;
  margin-right: 100rpx;
  transition: opacity 0.3s;
}

/* Header Section */
.header-section {
  position: relative;
  width: 100%;
  height: 680rpx; /* 略微收缩头部 */
  overflow: hidden;
  background-color: #2c3e50;
}

.bg-image, .bg-default, .bg-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.bg-default {
  background: linear-gradient(135deg, #2a2d3e 0%, #1a1c2c 100%);
}

.bg-mask {
  background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0.85) 100%);
  z-index: 1;
}

.user-info-box {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 0 40rpx 140rpx;
  box-sizing: border-box;
  z-index: 2;
  color: #fff;
}

.avatar-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.8);
}

.btn-edit, .btn-follow, .btn-chat {
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: 500;
  background: rgba(255,255,255,0.15);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255,255,255,0.25);
  color: #fff;
}

.btn-follow { background: #07c160; border: none; }

.main-info .nickname { font-size: 44rpx; font-weight: bold; margin-bottom: 6rpx; display: block; }
.main-info .user-id { font-size: 24rpx; opacity: 0.6; margin-bottom: 12rpx; display: block; }
.main-info .bio { font-size: 26rpx; opacity: 0.8; display: block; }

.stats-row { display: flex; gap: 40rpx; margin-top: 30rpx; }
.stat-item { display: flex; align-items: baseline; gap: 6rpx; }
.stat-item .num { font-size: 36rpx; font-weight: bold; }
.stat-item .label { font-size: 22rpx; opacity: 0.6; }

/* Content Tabs */
.content-section {
  position: relative;
  z-index: 10;
  margin-top: -80rpx;
  background-color: #f6f7f9; /* 这里改为底色 */
  border-radius: 48rpx 48rpx 0 0;
  overflow: hidden;
}

.tabs {
  display: flex;
  padding: 30rpx 40rpx 10rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #888;
  position: relative;
  padding-bottom: 20rpx;
}

.tab.active {
  color: #1a1a1a;
  font-weight: bold;
}

.tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 6rpx;
  background: #07c160;
  border-radius: 4rpx;
}

/* Card Lists */
.list-container {
  padding: 30rpx 24rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
  position: relative;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.title-area {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.tag-main {
  background: #2e4e3f; /* 截图中的暗绿色 */
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 500;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.empty-wrap {
  padding: 160rpx 0;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-img {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

.salary-text {
  color: #07c160; /* 绿色价格 */
  font-size: 34rpx;
  font-weight: bold;
}

.card-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin: 16rpx 0;
}

.card-image {
  width: 240rpx;
  height: 240rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
  margin-top: 10rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #bbb;
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #fcfcfc;
}

.footer-left {
  color: #999;
}

.footer-right {
  display: flex;
  gap: 20rpx;
}

.tag-hiring {
    background: #2e4e3f;
    color: #fff;
    font-size: 20rpx;
    padding: 4rpx 12rpx;
    border-radius: 6rpx;
}

.view-count { color: #999; }

.on-end {
    text-align: center;
    padding: 60rpx 0;
    color: #ccc;
    font-size: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20rpx;
}

.on-end::before, .on-end::after {
    content: "";
    width: 60rpx;
    height: 1rpx;
    background: #e0e0e0;
}

/* ======= Pull-to-Refresh Layout ======= */
.page-scroll {
    height: 100vh;
    background-color: #f6f7f9;
}

.refresh-container {
    width: 100%;
    height: 80rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 2000;
}

.refresh-icon {
    width: 48rpx;
    height: 48rpx;
    background: rgba(0,0,0,0.2);
    border-radius: 50%;
    padding: 10rpx;
}

.rotating {
    animation: rotate 1s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
