<view class="container">
  <!-- Custom Navigation Bar (Transparent/Absolute) -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="circle-btn" bindtap="goBack">
        <image src="/assets/images/chevron-left.png" class="nav-icon"></image>
      </view>

    </view>
  </view>

  <!-- Main Content Scroll Area -->
  <scroll-view scroll-y class="main-scroll" style="padding-top: {{statusBarHeight + 44}}px;">
    
    <!-- 1. Seller Info Header (Top) -->
    <view class="seller-header">
      <view class="seller-left">
        <image src="{{goods.fullSellerAvatar}}" mode="aspectFill" lazy-load class="seller-avatar" binderror="handleAvatarError" bindtap="navToProfile"></image>
        <view class="seller-info" bindtap="navToProfile">
          <text class="seller-name">{{goods.sellerName || '未知用户'}}</text>
          <text class="seller-meta">{{goods.formatTime}}</text>
        </view>
      </view>
      <view class="follow-btn {{isFollowed ? 'followed' : ''}}" bindtap="toggleFollowUser">
        {{ isFollowed ? '已关注' : '关注' }}
      </view>
    </view>

    <!-- 2. Product Image Swiper -->
    <view class="image-section">
      <swiper class="image-swiper" circular indicator-dots indicator-active-color="#214D39" indicator-color="rgba(33, 77, 57, 0.2)">
        <block wx:if="{{imageList.length > 0}}">
             <block wx:for="{{imageList}}" wx:key="*this">
                <swiper-item>
                    <image src="{{item}}" mode="aspectFill" lazy-load class="product-img" bindtap="previewImage" data-current="{{item}}" binderror="handleImageError" data-index="{{index}}"></image>
                </swiper-item>
             </block>
        </block>
        <block wx:else>
            <swiper-item>
                <view class="image-placeholder">
                    <image src="/assets/images/default-image.svg" mode="aspectFit" style="width: 120rpx; height: 120rpx; opacity: 0.1;"></image>
                    <text style="color: #ccc; font-size: 24rpx; margin-top: 20rpx;">无图片商品</text>
                </view>
            </swiper-item>
        </block>
      </swiper>
    </view>

    <!-- 3. Price & Title Section -->
    <view class="section-price">
      <view class="price-box">
        <text class="currency">¥</text>
        <text class="price">{{goods.price}}</text>
        <text class="status-tag" wx:if="{{goods.condition}}">{{goods.condition}}</text>
      </view>
      <view class="stats-box">
        <text>{{ goods.wantCount || 0 }}人想要</text>
        <text class="divider">·</text>
        <text>{{ goods.viewCount || 0 }}浏览</text>
      </view>
    </view>

    <view class="section-content">
      <text class="goods-title">{{goods.name}}</text>
      <text class="goods-desc" user-select>{{goods.description || '主人很懒，什么都没有留下~'}}</text>
    </view>

    <!-- 4. Params Grid (Details) -->
    <view class="section-params">
      <view style="display: flex; flex-wrap: wrap;">
        <view class="param-item">
          <text class="param-label">品牌</text>
          <text class="param-value">其他/未知</text>
        </view>
        <view class="param-item">
          <text class="param-label">成色</text>
          <text class="param-value">{{goods.condition || '未知'}}</text>
        </view>
        <view class="param-item">
          <text class="param-label">分类</text>
          <text class="param-value">{{goods.category || '其他'}}</text>
        </view>
      </view>
    </view>

    <!-- 5. Comments Section -->
    <view class="section-comments">
      <view class="comment-header">
        <text class="comment-title">全部留言 ({{comments.length}})</text>
      </view>
      
      <!-- Comment List -->
      <view wx:if="{{comments.length > 0}}" class="comment-list">
        <block wx:for="{{comments}}" wx:key="id">
          <view class="comment-item" bindlongpress="onCommentLongPress" data-id="{{item.id}}" data-userid="{{item.userId}}">
            <image src="{{item.fullAvatarUrl}}" mode="aspectFill" lazy-load class="comment-avatar" binderror="handleCommentAvatarError" data-index="{{index}}" bindtap="navToCommentProfile" data-userid="{{item.userId}}"></image>
            <view class="comment-body">
              <view class="comment-user-row">
                <text class="comment-user">{{item.nickname}}</text>
                <text class="seller-tag" wx:if="{{goods.userId == item.userId}}">卖家</text>
              </view>
              <text class="comment-content">{{item.content}}</text>
              <text class="comment-time">{{item.createTimeStr}}</text>
            </view>
          </view>
        </block>
      </view>
      
      <view wx:else style="padding: 60rpx 0; text-align: center;">
        <text style="color: #ccc; font-size: 26rpx;">暂无留言，快来互动吧~</text>
      </view>

      <!-- Integrated Comment Input -->
      <view class="comment-input-area">
        <input 
          type="text" 
          value="{{commentText}}" 
          bindinput="onCommentInput"
          placeholder="问问更多细节..." 
          class="static-input"
          cursor-spacing="20"
          bindconfirm="submitComment"
        />
        <view class="static-send-btn" bindtap="submitComment">发送</view>
      </view>
    </view>

    <!-- Bottom Spacer -->
    <view style="height: 180rpx;"></view>
  </scroll-view>

  <!-- Bottom Action Bar -->
  <view class="bottom-bar">
    <view class="bar-left">
      <view class="bar-btn" bindtap="toggleFavorite">
        <image src="{{favorite ? '/assets/images/Star.png' : '/assets/images/star-empty.png'}}" class="bar-icon star-anim {{favorite ? 'active' : ''}}"></image>
        <text>{{ favorite ? '已收藏' : '收藏' }}</text>
      </view>
      <view class="bar-btn" bindtap="showMoreActions">
        <image src="/assets/images/attention.png" class="bar-icon report-icon"></image>
        <text>举报</text>
      </view>
    </view>
    <view class="bar-right">
      <view class="buy-now-btn" bindtap="buyNow">我想要</view>
    </view>
  </view>

  <!-- Report Modal -->
  <view class="report-modal-mask" wx:if="{{showReportModal}}" bindtap="hideReportModal"></view>
  <view class="report-modal {{showReportModal ? 'show' : ''}}">
    <view class="report-header">
      <text class="report-title">举报内容</text>
      <view class="report-close" bindtap="hideReportModal">×</view>
    </view>
    <view class="report-body">
      <view class="report-section">
        <text class="report-label">举报类型</text>
        <view class="report-types">
          <view 
            class="report-type-item {{reportType === item.value ? 'active' : ''}}" 
            wx:for="{{reportTypes}}" 
            wx:key="value"
            bindtap="selectReportType"
            data-value="{{item.value}}"
          >
            {{item.label}}
          </view>
        </view>
      </view>
      <view class="report-section">
        <text class="report-label">举报理由</text>
        <textarea 
          class="report-textarea" 
          placeholder="请详细描述举报理由，以便我们更好地处理..."
          value="{{reportReason}}"
          bindinput="onReportReasonInput"
          maxlength="200"
        ></textarea>
        <text class="report-count">{{reportReason.length}}/200</text>
      </view>
    </view>
    <view class="report-footer">
      <view class="report-btn cancel" bindtap="hideReportModal">取消</view>
      <view class="report-btn submit" bindtap="submitReport">提交举报</view>
    </view>
  </view>
</view>
