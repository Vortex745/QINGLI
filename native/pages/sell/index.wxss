/** pages/sell/index.wxss **/
.page {
  min-height: 100vh;
  background-color: #F8F9FA;
  display: flex;
  flex-direction: column;
}

.content-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end; 
  padding-bottom: 200rpx; /* Tabbar height + more spacing */
}

.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 65vh;
  background: linear-gradient(180deg, rgba(46, 92, 53, 0.15) 0%, rgba(248,249,250,0) 100%);
  z-index: 0;
}

.greeting-area {
  padding: 60rpx;
  margin-bottom: auto; /* Push to top */
  z-index: 1;
  margin-top: 200rpx; 
}

.greeting-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #1A1A1A;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.greeting-sub {
  font-size: 32rpx;
  color: #666;
  font-weight: 300;
}

/* Action List */
.action-list {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  z-index: 1;
}

.action-card {
  background-color: #FFFFFF;
  border-radius: 32rpx;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  transition: transform 0.1s;
}

.card-hover {
  transform: scale(0.98);
  background-color: #FAFAFA;
}

.icon-box {
  width: 100rpx;
  height: 100rpx;
  background-color: #fff;
  border-radius: 24rpx;
  border: 1rpx solid #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.action-icon {
  width: 50rpx;
  height: 50rpx;
}

.text-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
}
