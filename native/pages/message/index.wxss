/** pages/message/index.wxss **/
.container {
  min-height: 100vh;
  background-color: #f8f9fa; /* Slightly gray bg */
}

.tabs {
  display: flex;
  height: 100rpx;
  background: #fff;
  padding: 10rpx 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  font-weight: 700;
  color: #000;
  font-size: 30rpx;
}

.active-line {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background-color: #07C160;
  border-radius: 4rpx;
}

.tab-dot {
  position: absolute;
  top: 24rpx;
  right: 60rpx;
  width: 14rpx;
  height: 14rpx;
  background-color: #FF4D4F;
  border-radius: 50%;
  border: 2rpx solid #fff;
}

.session-list {
  padding: 20rpx 30rpx;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f5f5f5;
  border: 2rpx solid #eee;
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #FF4D4F;
  color: #fff;
  font-size: 20rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border: 4rpx solid #fff;
}

.session-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.nickname {
  font-size: 32rpx;
  color: #111;
  font-weight: 600;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.last-msg {
  font-size: 26rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 450rpx;
}

.notice-list {
  padding: 20rpx 30rpx;
}

.notice-item {
  margin-bottom: 30rpx;
}

.notice-time {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 20rpx;
}

.notice-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.05);
  position: relative;
  border: 1rpx solid #f0f0f0;
}

.notice-card.unread {
  border-left: 8rpx solid #07C160;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.system-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
}

.system-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #07C160, #06AD56);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.unread-dot {
  margin-left: 16rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.card-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-arrow {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 24rpx;
  border-top: 2rpx dashed #eee;
}

.arrow-text {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
  font-weight: 500;
}

.arrow-icon {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #ccc;
  border-right: 3rpx solid #ccc;
  transform: rotate(45deg);
}

.loading-state {
  text-align: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-img {
  width: 180rpx;
  margin-bottom: 40rpx;
  opacity: 0.3;
}

.empty-state text {
  color: #ccc;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}
