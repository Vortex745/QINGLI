<!-- pages/login/index.wxml -->
<view class="login-container">
  <!-- Background -->
  <view class="bg-gradient"></view>
  <view class="bg-shape-1"></view>
  <view class="bg-shape-2"></view>

  <view class="content-wrapper">
    <view class="logo-section">
      <image class="app-logo" src="/assets/images/logo.png" mode="aspectFill"></image>
      <text class="app-name">青里</text>
      <text class="app-slogan">有趣、有味、有闲</text>
    </view>

    <!-- Glass Card -->
    <view class="form-card glass-effect">
      
      <!-- Initial State: Login Button -->
      <view wx:if="{{!showAuthModal}}" class="login-actions">
        <view class="welcome-text">
          <text class="title">欢迎回来</text>
          <text class="subtitle">登录体验完整功能</text>
        </view>

        <!-- Main Login Button -->
        <button class="login-btn primary-btn" bindtap="showAuthPopup">
           <image class="wechat-icon" src="/assets/images/wechat-icon.png" wx:if="{{false}}"></image>
           <text>微信一键登录</text>
        </button>

        <view class="agreement-box">
          <text class="agreement-text">
            登录即代表同意<text class="link">《用户协议》</text>和<text class="link">《隐私政策》</text>
          </text>
        </view>
      </view>

      <!-- Auth Modal (Inline for smoother UX) -->
      <view wx:else class="auth-modal-content">
        <view class="welcome-text">
          <text class="title">完善资料</text>
          <text class="subtitle">请授权您的头像和昵称</text>
        </view>

        <view class="avatar-wrapper">
          <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image src="{{avatarUrl || '/assets/images/avatar_default.png'}}" class="avatar-img"></image>
            <view class="edit-icon">
              <image src="/assets/images/camera-4-fill.png" class="camera-icon"></image>
            </view>
          </button>
          <text class="hint">点击设置头像</text>
        </view>

        <view class="input-group">
          <text class="label">昵称</text>
          <input type="nickname" class="nickname-input" value="{{nickname}}" placeholder="请输入昵称" bindblur="onNicknameBlur" bindinput="onNicknameInput" focus="{{showAuthModal}}"/>
        </view>

        <button class="login-btn primary-btn" bindtap="handleFinishLogin">确认并登录</button>
        
        <view class="cancel-link" bindtap="hideAuthPopup">
           <text>返回</text>
        </view>
      </view>

    </view>
  </view>
</view>
