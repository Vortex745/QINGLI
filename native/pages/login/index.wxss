/** pages/login/index.wxss **/
.login-container {
  min-height: 100vh;
  width: 100%;
  display: flex;
  flex-direction: column;
  position: relative;
  background: #f8f9fa;
  box-sizing: border-box;
}

/* Background Shapes */
.bg-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, #e7f5e9 0%, #ffffff 100%);
  z-index: 0;
}

.bg-shape-1 {
  position: absolute;
  top: -150rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(7, 193, 96, 0.05);
  border-radius: 50%;
  z-index: 0;
}

.bg-shape-2 {
  position: absolute;
  top: 200rpx;
  left: -150rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(7, 193, 96, 0.03);
  border-radius: 50%;
  z-index: 0;
}

.content-wrapper {
  position: relative;
  z-index: 10;
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 100rpx; /* Push content up slightly */
}

/* Logo Section */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.app-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 28rpx;
  box-shadow: 0 20rpx 40rpx rgba(7, 193, 96, 0.15);
  margin-bottom: 24rpx;
}

.app-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.app-slogan {
  font-size: 24rpx;
  color: #999;
  letter-spacing: 2rpx;
}

/* Form Card */
.form-card {
  width: 600rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  padding: 60rpx 50rpx;
  border-radius: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.3s ease;
}

/* Text */
.welcome-text {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #888;
}

/* Buttons */
.login-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
  position: relative;
}

.login-btn::after {
  border: none;
}

.primary-btn {
  background: #07C160;
  color: #fff;
  box-shadow: 0 10rpx 20rpx rgba(7, 193, 96, 0.2);
}

.primary-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 12rpx;
}

/* Agreement */
.agreement-box {
  text-align: center;
  margin-top: 10rpx;
}

.agreement-text {
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.4;
}

.link {
  color: #07C160;
  display: inline-block;
}

/* Auth Modal Content (Inline) */
.auth-modal-content {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: fadeIn 0.4s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Avatar Wrapper */
.avatar-wrapper {
  margin-bottom: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  padding: 0 !important;
  border-radius: 80rpx;
  background: #f0f0f0;
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,0.05);
  margin-bottom: 20rpx;
  position: relative;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 80rpx;
}

.edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  background: #07C160;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
}

.camera-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(100);
}

.hint {
  font-size: 24rpx;
  color: #999;
}

/* Input Group */
.input-group {
  width: 100%;
  margin-bottom: 60rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
  padding-left: 10rpx;
}

.nickname-input {
  width: 100%;
  height: 90rpx;
  background: #F2F4F2;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.nickname-input:focus {
  background: #fff;
  border: 2rpx solid #07C160;
}

/* Cancel Link */
.cancel-link {
  margin-top: 20rpx;
  padding: 10rpx 40rpx;
}

.cancel-text {
  font-size: 26rpx;
  color: #999;
}
