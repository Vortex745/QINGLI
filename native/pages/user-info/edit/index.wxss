/* pages/user-info/edit/index.wxss */
.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding: 20rpx;
  box-sizing: border-box;
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: #fff;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item:active {
    background-color: #f9f9f9;
}

.label {
  font-size: 30rpx;
  color: #333;
  width: 160rpx;
  font-weight: 500;
}

.right-content {
  display: flex;
  align-items: center;
}

.arrow {
  font-size: 32rpx;
  color: #ccc;
  margin-left: 10rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #eee;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

/* Background Image Item */
.bg-item {
    flex-direction: column;
    align-items: flex-start;
    padding: 30rpx;
}

.label-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.hint {
    font-size: 24rpx;
    color: #999;
}

.bg-preview {
    width: 100%;
    height: 300rpx;
    border-radius: 12rpx;
    background-color: #f0f0f0;
    object-fit: cover;
}

.bg-placeholder {
    width: 100%;
    height: 300rpx;
    background-color: #F8F9FA;
    border-radius: 12rpx;
    border: 2rpx dashed #DCDFE6;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
}

.plus-icon {
    font-size: 64rpx;
    color: #C0C4CC;
    font-weight: 300;
    line-height: 1;
    margin-bottom: 16rpx;
}

.placeholder-text {
    font-size: 26rpx;
    color: #909399;
}

/* Footer Button */
.footer-btn {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.save-btn {
  background: #2E5C35; /* Primary Green */
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(46, 92, 53, 0.2);
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
