/* Pages */
.page {
    min-height: 100vh;
    background-color: #fff;
}

/* Custom Header */
.custom-header-area {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: #fff;
    z-index: 100;
    display: flex;
    flex-direction: column;
    border-bottom: 1rpx solid #f8f8f8;
}

.header-spacer { width: 100%; }

.action-bar {
    height: 50px;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    justify-content: space-between;
}

.action-btn {
    font-size: 30rpx;
    padding: 10rpx 20rpx;
}

.action-btn.cancel { color: #666; }

.action-btn.publish {
    background-color: #2E5C35;
    color: #fff;
    font-weight: 600;
    border-radius: 30rpx;
    padding: 12rpx 36rpx;
    font-size: 28rpx;
}

.action-btn.publish.disabled {
    opacity: 0.5;
    background-color: #ccc;
}

.action-title {
    font-size: 34rpx;
    font-weight: bold;
    color: #333;
    position: absolute; left: 50%; transform: translateX(-50%);
}

/* Switcher */
.type-switcher {
    display: flex;
    padding: 30rpx 40rpx;
    gap: 30rpx;
}

.switch-item {
    flex: 1;
    height: 80rpx;
    border-radius: 12rpx;
    background-color: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30rpx;
    color: #666;
    transition: all 0.3s;
}

.switch-item.active {
    background-color: #2E5C35;
    color: #fff;
    font-weight: 600;
}

/* Form Styles */
.form-container {
    padding: 0 40rpx;
}

.form-item {
    display: flex;
    align-items: center;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f9f9f9;
}

.form-item.no-border { border-bottom: none; }

.label {
    width: 160rpx;
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
}

.input {
    flex: 1;
    font-size: 30rpx;
    color: #333;
    text-align: right;
}

.picker-val {
    flex: 1;
    font-size: 30rpx;
    color: #333;
    text-align: right;
}

.placeholder { color: #bbb; }

.arrow {
    color: #ccc;
    margin-left: 10rpx;
}

.title-input {
    width: 100%;
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
    min-height: 60rpx;
}

.datetime-box {
    flex: 1;
    display: flex;
    gap: 20rpx;
    justify-content: flex-end;
}

.datetime-val {
    background-color: #f5f5f5;
    padding: 6rpx 20rpx;
    border-radius: 8rpx;
    font-size: 28rpx;
    color: #333;
}
.datetime-val.placeholder { color: #bbb; }

.salary-box {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-end;
}

.salary-input {
    width: 150rpx;
    font-size: 36rpx;
    color: #FF5A5F;
    font-weight: bold;
    text-align: right;
    margin-right: 16rpx;
}

.unit-picker {
    background-color: #f5f5f5;
    padding: 8rpx 16rpx;
    border-radius: 8rpx;
    font-size: 26rpx;
    color: #555;
    display: flex;
    align-items: center;
}

.form-section {
    padding: 30rpx 0;
}

.section-label {
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 20rpx;
    display: block;
}

.textarea {
    width: 100%;
    height: 200rpx;
    background-color: #f9f9f9;
    border-radius: 12rpx;
    padding: 20rpx;
    font-size: 28rpx;
    color: #333;
    box-sizing: border-box;
}

.contact-box {
    flex: 1;
    display: flex;
    align-items: center;
}

.type-picker {
    background-color: #f5f5f5;
    padding: 8rpx 16rpx;
    border-radius: 8rpx;
    font-size: 28rpx;
    color: #333;
    display: flex;
    align-items: center;
    white-space: nowrap;
}

.divider {
    height: 20rpx;
    background-color: #f9f9f9;
    margin: 0 -40rpx;
}

.bottom-hint {
    padding: 40rpx;
    font-size: 24rpx;
    color: #ccc;
    text-align: center;
    margin-top: 20rpx;
}
