/* Pages */
.page {
    min-height: 100vh;
    background-color: #f8f8f8; /* Light gray background for contrast */
}

/* Custom Header */
.custom-header-area {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: #fff;
    z-index: 100;
    display: flex;
    flex-direction: column;
}

.header-spacer { width: 100%; }

.action-bar {
    height: 50px;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    justify-content: space-between;
}

.action-btn {
    font-size: 30rpx;
    padding: 10rpx 20rpx;
}

.action-btn.cancel { color: #333; font-weight: 500; }

.action-btn.publish {
    background-color: #2E5C35; /* Forest Green */
    color: #fff;
    font-weight: 600;
    border-radius: 30rpx;
    padding: 10rpx 34rpx;
    font-size: 28rpx;
}
.action-btn.publish.disabled {
    opacity: 0.6;
    background-color: #88a88e;
}

/* Input Area */
.input-container {
    background-color: #fff;
    padding: 30rpx 40rpx;
    margin-bottom: 20rpx;
}

.title-input {
    width: 100%;
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    height: 80rpx;
    border-bottom: 1rpx solid #f0f0f0;
    margin-bottom: 20rpx;
}
.title-placeholder { color: #ccc; }

.content-textarea {
    width: 100%;
    font-size: 30rpx;
    color: #333;
    line-height: 1.6;
    margin-bottom: 30rpx;
}
.content-placeholder { color: #ccc; }

.tags-display {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
    margin-bottom: 30rpx;
}
.tag-chip {
    font-size: 26rpx;
    color: #2E5C35;
    background-color: #e8f5e9;
    padding: 6rpx 20rpx;
    border-radius: 24rpx;
}

/* Image Grid */
.image-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.image-item {
    width: 216rpx; /* (750 - 80 - 32) / 3 approx */
    height: 216rpx;
    position: relative;
    border-radius: 8rpx;
    overflow: hidden;
    background-color: #f0f0f0;
}

.uploaded-img {
    width: 100%;
    height: 100%;
}

.delete-btn {
    position: absolute;
    top: 4rpx;
    right: 4rpx;
    width: 36rpx;
    height: 36rpx;
    background-color: rgba(0, 0, 0, 0.6);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 24rpx;
    z-index: 10;
}

.upload-btn {
    width: 216rpx;
    height: 216rpx;
    background-color: #f7f7f7;
    border-radius: 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.plus-icon {
    font-size: 60rpx;
    color: #ddd;
    font-weight: 300;
}

/* Options */
.options-container {
    background-color: #fff;
    padding: 0 40rpx;
    margin-bottom: 40rpx;
}

.option-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 34rpx 0;
    border-bottom: 1rpx solid #f9f9f9;
}
.option-item:last-child { border-bottom: none; }

.option-left {
    display: flex;
    align-items: center;
}

.option-icon {
    width: 40rpx;
    height: 40rpx;
    margin-right: 20rpx;
}
.option-icon-text {
    width: 40rpx;
    text-align: center;
    font-size: 32rpx;
    font-weight: bold;
    color: #666;
    margin-right: 20rpx;
}

.option-label {
    font-size: 30rpx;
    color: #333;
}

.option-right {
    display: flex;
    align-items: center;
    max-width: 60%;
}

.option-val {
    font-size: 28rpx;
    color: #333;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.option-val.placeholder { color: #ccc; }

.arrow {
    color: #ddd;
    margin-left: 10rpx;
    font-size: 24rpx;
}

/* Bottom */
.bottom-area {
    padding: 20rpx 40rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.tips {
    font-size: 24rpx;
    color: #999;
    margin-bottom: 20rpx;
}

.preview-link {
    font-size: 28rpx;
    color: #576b95; /* Link color */
}

/* Modals */
.modal-mask, .preview-mask {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0,0,0,0.6);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-box {
    background-color: #fff;
    width: 80%;
    border-radius: 20rpx;
    padding: 50rpx 40rpx;
}

.modal-title {
    font-size: 34rpx;
    font-weight: bold;
    text-align: center;
    margin-bottom: 40rpx;
}

.modal-input {
    background-color: #f5f5f5;
    height: 80rpx;
    border-radius: 10rpx;
    padding: 0 24rpx;
    margin-bottom: 40rpx;
    font-size: 30rpx;
}

.modal-btns {
    display: flex;
    gap: 30rpx;
}

.modal-btn {
    flex: 1;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 40rpx;
    font-size: 30rpx;
}
.modal-btn.cancel { background-color: #f2f2f2; color: #666; }
.modal-btn.confirm { background-color: #2E5C35; color: #fff; font-weight: 500; }

/* Preview */
.preview-container {
    width: 90%;
    max-height: 80vh;
    background-color: #fff;
    border-radius: 24rpx;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.preview-header {
    padding: 30rpx;
    text-align: center;
    font-weight: bold;
    position: relative;
    border-bottom: 1rpx solid #eee;
}

.close-preview {
    position: absolute;
    right: 30rpx;
    top: 24rpx;
    font-size: 40rpx;
    color: #999;
    padding: 0 10rpx;
}

.preview-content {
    flex: 1;
    overflow-y: auto;
}

.p-header {
    display: flex;
    align-items: center;
    padding: 30rpx;
}

.p-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    background-color: #eee;
}

.p-info {
    display: flex;
    flex-direction: column;
}

.p-name { font-weight: bold; font-size: 30rpx; color: #333; }
.p-time { font-size: 24rpx; color: #999; margin-top: 4rpx; }

.p-body {
    padding: 0 30rpx 40rpx;
}

.p-title {
    font-size: 34rpx;
    font-weight: bold;
    margin-bottom: 20rpx;
    color: #000;
}

.p-text {
    font-size: 30rpx;
    line-height: 1.6;
    color: #333;
    display: block;
    margin-bottom: 20rpx;
}

.p-tags {
    margin-bottom: 24rpx;
}
.p-tag {
    color: #576b95;
    margin-right: 16rpx;
    font-size: 28rpx;
}

.p-imgs {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}
.p-img {
    width: 100%;
    border-radius: 8rpx;
}

.preview-footer {
    padding: 30rpx;
    border-top: 1rpx solid #eee;
}

.pub-btn-full {
    background-color: #2E5C35;
    height: 88rpx;
    width: 100%;
    border-radius: 44rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 32rpx;
    color: #fff;
}
