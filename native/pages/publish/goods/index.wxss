/* Pages */
.page {
  min-height: 100vh;
  background-color: #fff;
}

/* Custom Header */
.custom-header-area {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 100;
  display: flex;
  flex-direction: column;
  border-bottom: 1rpx solid #f8f8f8;
}

.header-spacer { width: 100%; }

.action-bar {
  height: 50px;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  justify-content: space-between;
}

.action-btn {
  font-size: 30rpx;
  padding: 10rpx 20rpx;
}

.action-btn.cancel {
  color: #666;
}

.action-btn.publish {
  background-color: #2E5C35;
  color: #fff;
  font-weight: 600;
  border-radius: 30rpx;
  padding: 12rpx 36rpx;
  font-size: 28rpx;
}

.action-btn.publish.disabled {
  opacity: 0.5;
  background-color: #ccc;
}

.action-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* Form Styles */
.form-container {
  padding: 0 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f9f9f9;
}

.label {
  width: 160rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.sub-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

.picker-val {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
}

.placeholder {
  color: #bbb;
}

.arrow {
  color: #ccc;
  margin-left: 10rpx;
}

/* Price Input */
.price-input-box {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.currency {
  font-size: 32rpx;
  color: #FF5A5F;
  margin-right: 4rpx;
  font-weight: bold;
}

.currency.original {
  color: #999;
  font-weight: normal;
}

.price-input {
  width: 150rpx;
  text-align: right;
  font-size: 32rpx;
  color: #FF5A5F;
  font-weight: bold;
}

.price-input.original {
  color: #999;
  font-weight: normal;
}

/* Form Section */
.form-section {
  padding: 30rpx 0;
}

.section-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  display: block;
  margin-bottom: 20rpx;
}

.section-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-hint {
  font-size: 24rpx;
  color: #999;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* Image Grid */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  width: 210rpx;
  height: 210rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.uploaded-img {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom-left-radius: 12rpx;
  z-index: 10;
  font-size: 28rpx;
}

.upload-btn {
  width: 210rpx;
  height: 210rpx;
  background-color: #F7F7F7;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plus-icon {
  font-size: 60rpx;
  color: #ccc;
  font-weight: 300;
}

.divider {
  height: 20rpx;
  background-color: #f9f9f9;
  margin: 0 -40rpx;
}
