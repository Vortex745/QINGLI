/** pages/square/index.wxss **/
.container {
  min-height: 100vh;
  background-color: #F8F9FA;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.content-body {
    flex: 1;
    height: 0; /* Important for flex child scroll */
}

.feed-scroll {
    height: 100%;
}

.search-container {
  padding: 20rpx 40rpx 10rpx;
  background-color: #fff;
}

.search-bar {
  background-color: #F7F7F7;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* Sticky Header */
.sticky-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background-color: #fff;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  padding-bottom: 10rpx;
}

.topics-wrapper {
  white-space: nowrap;
  width: 100%;
  padding: 10rpx 0 20rpx 40rpx;
}

.topic-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
  position: relative;
  padding-bottom: 10rpx;
  vertical-align: top;
}

.topic-text {
  font-size: 30rpx;
  color: #999;
  transition: all 0.3s;
}

.topic-text.active-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #214D39;
}

.active-indicator {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: #214D39;
  border-radius: 6rpx;
}

/* Sort Filter */
.sort-filter {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 10rpx 40rpx 20rpx;
}

.sort-item {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 14rpx;
}

.sort-item.active {
  color: #214D39;
  font-weight: 600;
 background: rgba(33, 77, 57, 0.08);
  border-radius: 8rpx;
}

.sort-divider {
  margin: 0 10rpx;
  color: #eee;
  font-size: 18rpx;
}

/* Feed List */
.feed-list {
  padding: 20rpx 30rpx;
}

.post-card {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
  border: 1rpx solid #F9F9F9;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background-color: #f5f5f5;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.sub-info {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.post-time {
  font-size: 24rpx;
  color: #ccc;
}

.type-tag {
    font-size: 20rpx;
    padding: 2rpx 10rpx;
    border-radius: 6rpx;
    background: #EAF2EB;
    color: #214D39;
}

.post-content {
  margin-bottom: 24rpx;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* Job Card */
.job-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
}

.job-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.job-salary {
    font-size: 30rpx;
    color: #214D39;
    font-weight: 800;
}

.job-tags-row {
    display: flex;
    gap: 16rpx;
    margin-bottom: 16rpx;
}

.job-tag {
    font-size: 22rpx;
    color: #214D39;
    background: rgba(33, 77, 57, 0.08);
    padding: 6rpx 12rpx;
    border-radius: 8rpx;
}

.job-desc {
    color: #666;
    font-size: 26rpx;
}

/* Lost Found Card */
.lf-header {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.lf-tag {
    font-size: 22rpx;
    padding: 6rpx 16rpx;
    border-radius: 8rpx;
    margin-right: 16rpx;
    color: #fff;
}

.tag-lost { background: #FF5A5F; }
.tag-found { background: #214D39; }

.lf-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #333;
}

.lf-meta {
    margin-top: 20rpx;
    background: #F9F9F9;
    padding: 20rpx;
    border-radius: 16rpx;
}

.lf-info-row {
    display: flex;
    align-items: center;
    font-size: 24rpx;
    color: #666;
    margin-bottom: 12rpx;
}

.lf-info-row:last-child { margin-bottom: 0; }
.lf-icon { margin-right: 12rpx; opacity: 0.6; }

/* Square Card */
.square-title {
    font-size: 30rpx;
    font-weight: bold;
    display: block;
    margin-bottom: 12rpx;
    color: #333;
}

/* Images */
.post-images.single .image-wrapper {
    width: 100%;
    margin-bottom: 24rpx;
    border-radius: 20rpx;
    overflow: hidden;
    background: #f5f5f5;
}

.content-img {
    width: 100%;
    display: block;
}

/* Footer */
.post-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 48rpx;
  margin-top: 10rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.7;
}

.action-count {
  font-size: 24rpx;
  color: #999;
}

.count-active {
    color: #FF5A5F;
}

/* Empty State */
.empty-wrap {
    padding: 160rpx 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.empty-img {
    width: 180rpx;
    height: 180rpx;
    margin-bottom: 24rpx;
    opacity: 0.2;
}

.empty-tip {
    font-size: 26rpx;
    color: #999;
}

.loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 100rpx 0;
    color: #999;
}

/* Refresh */
.refresh-container {
    width: 100%;
    height: 80rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.refresh-icon {
    width: 48rpx;
    height: 48rpx;
}

.rotating {
    animation: rotate 1s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

/* Footer */
.footer-end {
    padding: 30rpx 0 20rpx;
    text-align: center;
}

.footer-end text {
    font-size: 24rpx;
    color: #ccc;
}
