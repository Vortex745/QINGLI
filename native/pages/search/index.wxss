/* pages/search/index.wxss */
page {
  background-color: #f6f7f9;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Search Header */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  background: #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
}

.cancel-btn {
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #07c160;
  font-weight: 500;
}

/* Suggestion Area */
.suggestion-area {
  padding: 30rpx;
}

.section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.clear-history {
  font-size: 24rpx;
  color: #999;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.tag {
  padding: 16rpx 28rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #555;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tag.hot {
  background: linear-gradient(135deg, #fff4e5 0%, #ffecd2 100%);
  color: #e67e00;
}

/* Result Area */
.result-area {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 100rpx;
  z-index: 99;
}

.result-tabs .tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  padding-bottom: 16rpx;
}

.result-tabs .tab.active {
  color: #333;
  font-weight: 600;
}

.result-tabs .tab.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 30%;
  right: 30%;
  height: 6rpx;
  background: #07c160;
  border-radius: 3rpx;
}

.filter-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #f8f8f8;
}

.filter-item {
  position: relative;
  font-size: 26rpx;
  color: #888;
  margin-left: 40rpx;
  padding: 8rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.filter-item.active {
  color: #333;
  font-weight: 600;
}

.filter-dot {
  width: 8rpx;
  height: 8rpx;
  background: #07c160;
  border-radius: 50%;
  margin-top: 6rpx;
}

.result-scroll {
  flex: 1;
  height: 0;
}

.result-list {
  padding: 20rpx 24rpx;
}

/* Result Card */
.result-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.result-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  overflow: hidden;
}

.result-type-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  margin-bottom: 12rpx;
  align-self: flex-start;
}

.result-type-tag.type-goods { background: #e6f7ff; color: #1890ff; }
.result-type-tag.type-post { background: #f6ffed; color: #52c41a; }
.result-type-tag.type-job { background: #fff7e6; color: #fa8c16; }
.result-type-tag.type-lost { background: #fff1f0; color: #f5222d; }

.result-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

.result-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.result-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.result-price {
  font-size: 32rpx;
  color: #fa5151;
  font-weight: 600;
}

.result-time {
  font-size: 22rpx;
  color: #bbb;
}

/* States */
.loading-state, .empty-state, .no-more {
  padding: 60rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  color: #999;
}
