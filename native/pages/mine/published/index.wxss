/** pages/mine/published/index.wxss **/
.page {
    min-height: 100vh;
    background-color: #F8F9FA;
    display: flex;
    flex-direction: column;
}

/* Custom Header */
.custom-header {
    background-color: #fff;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
}

.status-bar {
    width: 100%;
}

.nav-bar {
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0 16px;
}

.back-btn {
    position: absolute;
    left: 16px;
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

.nav-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #333;
}

/* Tabs */
.tabs-container {
    background: #fff;
    padding: 0 40rpx;
    position: sticky;
    top: 0; /* Updated dynamically via style in wxml */
    z-index: 99;
}

.tabs-wrapper {
    display: flex;
    height: 88rpx;
    align-items: center;
    border-bottom: 1rpx solid #eee;
}

.tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    position: relative;
    transition: all 0.2s ease;
}

.tab-item:active {
    transform: scale(0.95);
}

.tab-text {
    font-size: 28rpx;
    color: #8E8E93;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.active .tab-text {
    color: #2E5C35;
    font-weight: 700;
    font-size: 32rpx;
}

.active-line {
    position: absolute;
    bottom: 8rpx;
    width: 32rpx;
    height: 6rpx;
    background: #2E5C35;
    border-radius: 3rpx;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Content List */
.content-list {
    flex: 1;
    padding: 24rpx 30rpx;
    box-sizing: border-box;
}

/* Row entrance animation */
@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30rpx); }
    to { opacity: 1; transform: translateY(0); }
}

/* Card Styles - Based on Square/Goods */

/* Goods Card - Horizontal List Style */
.goods-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 24rpx;
    display: flex;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
    animation: fadeInUp 0.5s ease backwards;
    transition: transform 0.2s;
}

.goods-card:active {
    transform: scale(0.98);
}

.goods-img {
    width: 200rpx;
    height: 200rpx;
    border-radius: 12rpx;
    background: #f5f5f5;
    margin-right: 24rpx;
    flex-shrink: 0;
}

.goods-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.goods-title {
    font-size: 30rpx;
    color: #333;
    font-weight: 600;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.goods-meta {
    display: flex;
    flex-direction: column;
    gap: 8rpx;
}

.goods-price-row {
    display: flex;
    align-items: baseline;
    gap: 12rpx;
}

.price {
    font-size: 34rpx;
    color: #FF5A5F;
    font-weight: bold;
}

.original-price {
    font-size: 24rpx;
    color: #999;
    text-decoration: line-through;
}

.status-tag {
    font-size: 22rpx;
    color: #fff;
    background: #ccc;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
    align-self: flex-start;
}
.status-active { background: #2E5C35; color: #fff; }
.status-sold { background: #ccc; color: #fff; }

.post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16rpx;
    border-top: 1rpx solid #f5f5f5;
    margin-top: 10rpx;
}


/* Generic Post Card (For Square, Job, LostFound) */
.post-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 30rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
    animation: fadeInUp 0.5s ease backwards;
    transition: transform 0.2s;
}

.post-card:active {
    transform: scale(0.98);
}

.card-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 16rpx;
}

.card-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
}

.card-time {
    font-size: 24rpx;
    color: #999;
}

.card-content {
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
    margin-bottom: 20rpx;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.card-images-scroll {
    white-space: nowrap;
    margin-bottom: 20rpx;
}

.scroll-img {
    width: 200rpx;
    height: 200rpx;
    border-radius: 12rpx;
    display: inline-block;
    margin-right: 16rpx;
    background: #f5f5f5;
}

/* Job Specific */
.job-salary {
    color: #2E5C35;
    font-weight: bold;
    font-size: 30rpx;
}

/* LostFound Specific */
.lf-type {
    padding: 4rpx 12rpx;
    border-radius: 6rpx;
    font-size: 22rpx;
    color: #fff;
    margin-right: 12rpx;
}
.lf-lost { background: #FF5A5F; }
.lf-found { background: #2E5C35; }

/* Empty State */
.empty-state {
    padding: 200rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.empty-icon {
    width: 160rpx;
    height: 160rpx;
    margin-bottom: 24rpx;
    opacity: 0.3;
}

.empty-text {
    color: #ccc;
    font-size: 28rpx;
    letter-spacing: 2rpx;
}

/* Footer End Style */
.footer-end {
    padding: 60rpx 0 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.end-line {
    width: 60rpx;
    height: 1rpx;
    background: #e0e0e0;
}

.end-text {
    font-size: 24rpx;
    color: #999;
    margin: 0 30rpx;
}

.goods-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.delete-btn-text {
    font-size: 24rpx;
    color: #999;
    padding: 4rpx 10rpx;
    border: 1rpx solid #eee;
    border-radius: 6rpx;
    margin-left: 10rpx;
}

.delete-btn-text:active {
    background-color: #f5f5f5;
    color: #FF5A5F;
    border-color: #FF5A5F;
}
