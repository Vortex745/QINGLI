/** pages/mine/index.wxss **/
.page {
  min-height: 100vh;
  background-color: #F8F9FA;
  padding-bottom: 200rpx;
}

/* User Header */
.user-header {
  background-color: #fff;
  padding: 40rpx 40rpx 40rpx;
  /* margin-bottom: 24rpx; */
  padding-top: 120rpx;
  margin-bottom: 24rpx;
}

.user-info-row {
  display: flex;
  align-items: center;
  margin-bottom: 50rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  margin-right: 32rpx;
  background-color: #eee;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.username {
  font-size: 40rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.user-id {
  font-size: 26rpx;
  color: #999;
}

.user-bio {
    font-size: 26rpx;
    color: #999;
    margin-top: 4rpx;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.arrow-right {
    margin-left: auto;
    padding-left: 20rpx;
}

/* Stats Row */
.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #1A1A1A;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

/* Section Card */
.section-card {
  background-color: #fff;
  margin: 0 30rpx 30rpx;
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A1A1A;
}

/* Menu List */
.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F8F8F8;
}

.menu-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-hover {
  opacity: 0.7;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bg-purple-light { background-color: rgba(94, 92, 230, 0.1); }
.bg-orange-light { background-color: rgba(255, 159, 10, 0.1); }
.bg-red-light { background-color: rgba(255, 90, 95, 0.1); }
.bg-blue-light { background-color: rgba(10, 132, 255, 0.1); }

.menu-icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.logout-text {
  color: #FF3B30 !important;
}

.arrow {
  color: #ddd;
  font-size: 32rpx;
}

/* ======= Pull-to-Refresh Layout ======= */
.page-scroll {
    height: 100vh;
    background-color: #F8F9FA;
}

.refresh-container {
    width: 100%;
    height: 80rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    background: transparent;
}

.refresh-icon {
    width: 48rpx;
    height: 48rpx;
    background: rgba(0,0,0,0.05);
    border-radius: 50%;
    padding: 10rpx;
}

.rotating {
    animation: rotate 1s linear infinite;
}

@keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
