<view class="page">
    <!-- Custom Header -->
    <view class="custom-header" style="height: {{headerTotalHeight}}px;">
        <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
        <view class="nav-bar">
            <view class="back-btn" bindtap="goBack">
                <text class="arrow-left">❮</text>
            </view>
            <view class="nav-title">我的收藏</view>
        </view>
    </view>

    <!-- Content Area Padding -->
    <view style="height: {{headerTotalHeight}}px;"></view>

    <!-- Tabs -->
    <view class="tabs-container" style="top: {{headerTotalHeight}}px;">
        <view class="tabs-wrapper">
            <view class="tab-item {{currentTab === index ? 'active' : ''}}" 
                  wx:for="{{tabs}}" wx:key="index" 
                  bindtap="switchTab" data-index="{{index}}">
                <text class="tab-text">{{item.name}}</text>
                <view class="active-line" wx:if="{{currentTab === index}}"></view>
            </view>
        </view>
    </view>

    <!-- List Content -->
    <view class="content-list">
        <!-- Empty State -->
        <view class="empty-state" wx:if="{{!loading && list.length === 0}}">
            <image class="empty-icon" src="/assets/images/star-empty.png" mode="aspectFit"></image>
            <text class="empty-text">收藏夹现在是空的</text>
        </view>

        <!-- Unified Card Style -->
        <view class="favorite-card" wx:for="{{list}}" wx:key="id" 
              bindtap="goDetail" data-item="{{item}}">
            <image class="card-cover" src="{{item.coverImage}}" mode="aspectFill" 
                   catchtap="previewImage" data-url="{{item.coverImage}}"></image>
            <view class="card-info">
                <view class="card-header">
                    <text class="card-title">{{item.title}}</text>
                    <text class="card-type-tag {{item.typeClass}}">{{item.typeLabel}}</text>
                </view>
                <text class="card-desc">{{item.description}}</text>
                <view class="card-footer">
                    <view class="price-box" wx:if="{{item.price}}">
                        <text class="currency">¥</text>
                        <text class="price">{{item.price}}</text>
                    </view>
                    <view class="user-info" wx:if="{{item.userName}}">
                        <image class="user-avatar" src="{{item.userAvatar}}" mode="aspectFill"></image>
                        <text class="user-name">{{item.userName}}</text>
                    </view>
                    <text class="card-time">{{item.timeText}}</text>
                </view>
            </view>
            <!-- Uncollect Button -->
            <view class="uncollect-btn" catchtap="toggleFavorite" data-item="{{item}}">
                <image class="uncollect-icon" src="/assets/images/Star.png" mode="aspectFit"></image>
            </view>
        </view>

        <!-- Loading & End States -->
        <view class="loading-state" wx:if="{{loading}}">
            <text>加载中...</text>
        </view>
        <view class="footer-end" wx:if="{{!hasMore && list.length > 0}}">
            <view class="end-line"></view>
            <text class="end-text">已经到底啦</text>
            <view class="end-line"></view>
        </view>
    </view>
</view>
