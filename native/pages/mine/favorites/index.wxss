/** pages/mine/favorites/index.wxss **/
.page {
    min-height: 100vh;
    background-color: #F8F9FA;
    display: flex;
    flex-direction: column;
}

/* Custom Header */
.custom-header {
    background-color: #fff;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
}

.status-bar {
    width: 100%;
}

.nav-bar {
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0 16px;
}

.back-btn {
    position: absolute;
    left: 16px;
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
    transition: transform 0.2s;
}

.back-btn:active {
    transform: scale(0.9);
}

.nav-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #1A1A1A;
}

/* Tabs */
.tabs-container {
    background: #fff;
    padding: 0 20rpx;
    position: sticky;
    top: 0;
    z-index: 99;
}

.tabs-wrapper {
    display: flex;
    height: 88rpx;
    align-items: center;
    border-bottom: 1rpx solid #eee;
}

.tab-item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    position: relative;
    transition: all 0.2s ease;
}

.tab-item:active {
    transform: scale(0.95);
}

.tab-text {
    font-size: 28rpx;
    color: #8E8E93;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.tab-item.active .tab-text {
    color: #2E5C35;
    font-weight: 700;
    font-size: 30rpx;
}

.active-line {
    position: absolute;
    bottom: 8rpx;
    width: 32rpx;
    height: 6rpx;
    background: #2E5C35;
    border-radius: 3rpx;
}

/* Content List */
.content-list {
    flex: 1;
    padding: 24rpx 30rpx;
    box-sizing: border-box;
    margin-top: 88rpx;
}

/* Empty State */
.empty-state {
    padding: 120rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: fadeIn 0.5s ease;
}

.empty-icon {
    width: 120rpx;
    height: 120rpx;
    opacity: 0.3;
    margin-bottom: 24rpx;
}

.empty-text {
    color: #999;
    font-size: 28rpx;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20rpx); }
    to { opacity: 1; transform: translateY(0); }
}

/* Unified Favorite Card */
.favorite-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 24rpx;
    display: flex;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03);
    position: relative;
    animation: fadeInUp 0.5s ease backwards;
    transition: transform 0.2s;
}

.favorite-card:active {
    transform: scale(0.98);
}

@keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30rpx); }
    to { opacity: 1; transform: translateY(0); }
}

/* Staggered animation */
.favorite-card:nth-child(1) { animation-delay: 0.05s; }
.favorite-card:nth-child(2) { animation-delay: 0.1s; }
.favorite-card:nth-child(3) { animation-delay: 0.15s; }
.favorite-card:nth-child(4) { animation-delay: 0.2s; }
.favorite-card:nth-child(5) { animation-delay: 0.25s; }

.card-cover {
    width: 180rpx;
    height: 180rpx;
    border-radius: 16rpx;
    background: #f5f5f5;
    margin-right: 24rpx;
    flex-shrink: 0;
}

.card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
}

.card-header {
    display: flex;
    /* Use padding to avoid title overlapping with absolute Star Icon on the right */
    padding-right: 80rpx; 
    align-items: flex-start;
}

.card-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1A1A1A;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
    line-height: 1.4;
}

/* Move Tag to Top-Left of the Card (Overlaying the Image) */
.card-type-tag {
    position: absolute;
    top: 24rpx;
    left: 24rpx;
    z-index: 10;
    font-size: 20rpx;
    padding: 6rpx 14rpx;
    border-top-left-radius: 16rpx;
    border-bottom-right-radius: 16rpx;
    color: #fff;
    font-weight: 500;
    box-shadow: 2rpx 2rpx 6rpx rgba(0,0,0,0.2);
    flex-shrink: 0;
}

.type-goods { background: linear-gradient(135deg, #FF6B6B, #FF8787); }
.type-post { background: linear-gradient(135deg, #4ECDC4, #66D9D1); }
.type-job { background: linear-gradient(135deg, #45B7D1, #5CCBE5); }
.type-lf { background: linear-gradient(135deg, #F7B731, #FDCB58); }

.card-desc {
    font-size: 26rpx;
    color: #666;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 8rpx 0;
}

.card-footer {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.price-box {
    display: flex;
    align-items: baseline;
}

.currency {
    font-size: 22rpx;
    color: #FF5555;
    font-weight: 700;
}

.price {
    font-size: 32rpx;
    color: #FF5555;
    font-weight: 700;
}

.user-info {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.user-avatar {
    width: 36rpx;
    height: 36rpx;
    border-radius: 50%;
    background: #eee;
}

.user-name {
    font-size: 22rpx;
    color: #999;
    max-width: 100rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.card-time {
    font-size: 22rpx;
    color: #999;
    margin-left: auto;
}

/* Uncollect Button */
.uncollect-btn {
    position: absolute;
    top: 24rpx;
    right: 24rpx;
    width: 56rpx;
    height: 56rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s;
}

.uncollect-btn:active {
    transform: scale(0.8);
}

.uncollect-icon {
    width: 40rpx;
    height: 40rpx;
}

/* Loading & Footer */
.loading-state {
    text-align: center;
    padding: 40rpx 0;
    color: #999;
    font-size: 26rpx;
}

.footer-end {
    padding: 60rpx 0 100rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.end-line {
    width: 60rpx;
    height: 1rpx;
    background: #e0e0e0;
}

.end-text {
    font-size: 24rpx;
    color: #999;
    margin: 0 30rpx;
}
