.container {
    min-height: 100vh;
    background-color: #F8F9FA;
    display: flex;
    flex-direction: column;
}

.main-scroll {
    flex: 1;
    height: 100vh;
    box-sizing: border-box;
}

/* Nav */
.nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    pointer-events: none;
}

.nav-content {
    height: 44px;
    padding: 0 30rpx;
    display: flex;
    align-items: center;
    pointer-events: auto;
}

.circle-btn {
    width: 68rpx;
    height: 68rpx;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(8px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.nav-icon {
    width: 40rpx;
    height: 40rpx;
}

/* Header */
.seller-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    background-color: #fff;
}

.seller-left {
    display: flex;
    align-items: center;
}

.seller-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.seller-name {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
}

.seller-meta {
    font-size: 22rpx;
    color: #999;
    margin-top: 4rpx;
}

.follow-btn {
    padding: 10rpx 30rpx;
    border-radius: 30rpx;
    background-color: #214D39;
    color: #fff;
    font-size: 24rpx;
}

/* Post Content */
.section-post {
    padding: 10rpx 30rpx 30rpx;
    background-color: #fff;
}

.post-title {
    font-size: 34rpx;
    font-weight: 800;
    color: #1A1A1A;
    margin-bottom: 20rpx;
    display: block;
}

.post-text {
    font-size: 30rpx;
    color: #333;
    line-height: 1.6;
    display: block;
}

.image-grid {
    margin-top: 24rpx;
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.grid-img {
    width: calc(33.33% - 8rpx);
    height: 220rpx;
    border-radius: 12rpx;
}

.grid-img.large {
    width: 100%;
    height: 480rpx;
}

/* Stats */
.post-stats {
    padding: 20rpx 30rpx;
    background-color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 24rpx;
    color: #999;
    border-bottom: 1rpx solid #F0F2F0;
}

.stats-right { display: flex; gap: 30rpx; }

.stats-row {
    background-color: #fff;
    padding: 20rpx 30rpx;
    border-bottom: 1rpx solid #f8f8f8;
}

.stats-left {
    display: flex;
    align-items: center;
    font-size: 24rpx;
    color: #999;
}

.divider {
    margin: 0 10rpx;
}

.stat-item {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.stat-icon {
    width: 36rpx;
    height: 36rpx;
}

/* Comments */
.section-comments {
    padding: 40rpx 30rpx;
    background-color: #fff;
    margin-top: 20rpx;
}

.comment-header { margin-bottom: 30rpx; }

.comment-title {
    font-size: 32rpx;
    font-weight: 800;
    color: #1A1A1A;
}

.comment-item {
    display: flex;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #F0F2F0;
}

.comment-avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    margin-right: 20rpx;
}

.comment-body { flex: 1; }

.comment-user-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.comment-user {
    font-size: 26rpx;
    font-weight: 600;
    color: #333;
}

.seller-tag {
    font-size: 18rpx;
    padding: 2rpx 10rpx;
    background-color: #EAF2EB;
    color: #214D39;
    border-radius: 6rpx;
    font-weight: bold;
}

.comment-content {
    font-size: 28rpx;
    color: #444;
    line-height: 1.5;
    margin: 10rpx 0;
}

.comment-footer {
    display: flex;
    gap: 20rpx;
}

.comment-time {
    font-size: 22rpx;
    color: #999;
}

.comment-empty {
    padding: 60rpx 0;
    text-align: center;
    color: #ccc;
    font-size: 26rpx;
}

/* Bottom Input Bar */
.bottom-input-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 110rpx;
    background: #fff;
    display: flex;
    align-items: center;
    padding: 0 30rpx;
    box-sizing: border-box;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
    z-index: 100;
}

.like-btn-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 90rpx;
    margin-right: 10rpx;
}

.like-icon-large {
    width: 48rpx;
    height: 48rpx;
    margin-bottom: 2rpx;
}

/* 统一图标比例 */
.like-btn-wrapper:nth-child(2) .like-icon-large {
    width: 48rpx;
    height: 48rpx;
    margin-top: 0;
    margin-bottom: 2rpx;
}

.like-text-label {
    font-size: 18rpx; /* 微调字体大小以适应紧凑布局 */
    color: #666;
    font-weight: 500;
}

.like-count-text {
    font-size: 18rpx;
    color: #999;
}

.input-wrapper {
    flex: 1;
    background: #F5F5F5;
    height: 72rpx;
    border-radius: 36rpx;
    display: flex;
    align-items: center;
    padding: 0 24rpx;
    margin-right: 20rpx;
}

.bar-input {
    width: 100%;
    font-size: 28rpx;
    color: #333;
}

.send-btn-small {
    padding: 12rpx 24rpx;
    background: #214D39;
    color: #fff;
    border-radius: 30rpx;
    font-size: 26rpx;
}

/* Input Area */
.comment-input-area {
    margin-top: 40rpx;
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.static-input {
    flex: 1;
    height: 80rpx;
    background-color: #F7F8FA;
    border-radius: 40rpx;
    padding: 0 32rpx;
    font-size: 28rpx;
}

.static-send-btn {
    padding: 0 40rpx;
    height: 80rpx;
    background: #214D39;
    border-radius: 40rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 28rpx;
    font-weight: 600;
}

/* Nav Actions */
.nav-content {
    justify-content: space-between;
}

.nav-actions { display: flex; }

.share-dot {
    font-weight: bold;
    color: #214D39;
    letter-spacing: 2rpx;
}

/* Report Modal Styles */
.report-modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 9100;
}

.report-modal {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    max-height: 80vh;
    background: #fff;
    border-radius: 32rpx 32rpx 0 0;
    z-index: 9101;
    transform: translateY(100%);
    transition: transform 0.3s ease;
}

.report-modal.show {
    transform: translateY(0);
}

.report-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.report-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #1a1a1a;
}

.report-close {
    width: 60rpx;
    height: 60rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 48rpx;
    color: #999;
}

.report-body {
    padding: 30rpx;
    max-height: 50vh;
    overflow-y: auto;
}

.report-section {
    margin-bottom: 40rpx;
}

.report-label {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 20rpx;
    display: block;
}

.report-types {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.report-type-item {
    padding: 16rpx 28rpx;
    border-radius: 32rpx;
    border: 2rpx solid #e0e0e0;
    font-size: 26rpx;
    color: #666;
    background: #fff;
}

.report-type-item.active {
    border-color: #214D39;
    background: #EAF2EB;
    color: #214D39;
    font-weight: 600;
}

.report-textarea {
    width: 100%;
    height: 200rpx;
    padding: 24rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 16rpx;
    font-size: 28rpx;
    box-sizing: border-box;
    background: #fafafa;
}

.report-count {
    display: block;
    text-align: right;
    font-size: 24rpx;
    color: #999;
    margin-top: 12rpx;
}

.report-footer {
    display: flex;
    padding: 24rpx 30rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    gap: 20rpx;
    border-top: 1rpx solid #f0f0f0;
}

.report-btn {
    flex: 1;
    height: 88rpx;
    border-radius: 44rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30rpx;
    font-weight: 600;
}

.report-btn.cancel {
    background: #f5f5f5;
    color: #666;
}

.report-btn.submit {
    background: #214D39;
    color: #fff;
}
